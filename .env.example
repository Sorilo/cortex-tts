BREEZE_MODEL_DIR=/absolute/path/to/breeze-model
BREEZE_VOICES_DIR=/absolute/path/to/voices
BREEZE_GPU_DEVICE=0
CORTEX_TTS_TOKEN=replace-with-random-local-secret
CORTEX_TTS_BIND=127.0.0.1
CORTEX_TTS_API_PORT=18080
CORTEX_TTS_WYOMING_PORT=10220
BREEZE_VOICE=
BREEZE_INSTRUCTION=Speak clearly and naturally.
# Provisional balance: faster cancel/first PCM than four frames, fewer tiny gaps than one.
BREEZE_CHUNK_FIRST=2
BREEZE_CHUNK_MAX=25
